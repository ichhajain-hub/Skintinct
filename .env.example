# --- Telegram ---
# BotFather token for the bot Meera already talks to.
TELEGRAM_BOT_TOKEN=
# The one chat id this bot will act on (hers). Everything else is ignored.
TELEGRAM_CHAT_ID=
# Random string you invent; passed to setWebhook and checked on every request
# so randoms who find the webhook URL can't feed it fake notes.
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub (state + published/ persistence) ---
# Fine-grained PAT with Contents: Read & write on this one repo only.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Gemini ---
GEMINI_API_KEY=
# Any current Gemini model that supports the google_search grounding tool
# and JSON-schema structured output.
GEMINI_MODEL=gemini-2.5-flash

# --- Vercel Cron auth ---
# Set the same value here and Vercel will send it back as
# `Authorization: Bearer <value>` on cron-triggered requests; the cron
# handlers reject anything else so the endpoints can't be triggered by URL.
CRON_SECRET=

# --- Selection tuning ---
# Minimum triage score (0-10) a note/cluster needs to be eligible for drafting.
# If nothing clears this bar on a run, we send fewer drafts that week
# instead of lowering it.
SELECTION_MIN_SCORE=6
